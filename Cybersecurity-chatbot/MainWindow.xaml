<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="720" Width="980"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBg"        Color="#0D1117"/>
        <SolidColorBrush x:Key="PanelBg"       Color="#161B22"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#00FF9C"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentOrange"  Color="#FF7B54"/>
        <SolidColorBrush x:Key="MutedText"     Color="#8B949E"/>
        <SolidColorBrush x:Key="LightText"     Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Border1"       Color="#30363D"/>
        <SolidColorBrush x:Key="UserBubble"    Color="#1F3A5F"/>
        <SolidColorBrush x:Key="BotBubble"     Color="#1A2332"/>
        <SolidColorBrush x:Key="InputBg"       Color="#21262D"/>

        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background" Value="#00FF9C"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00CC7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#009960"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D3748"/>
                                <Setter Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Border1}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,10">
                    <TextBlock FontFamily="Consolas"
                               FontSize="9"
                               Foreground="{StaticResource AccentGreen}"
                               TextWrapping="Wrap"
                               LineHeight="12"
                               xml:space="preserve"> ██████╗██╗   ██╗██████╗ ███████╗██████╗
██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗
██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝
██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗
╚██████╗   ██║   ██████╔╝███████╗██║  ██║
 ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝</TextBlock>
                    <TextBlock Text="SECURITY AWARENESS BOT"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBlue}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <Separator Margin="0,10,0,0" Background="{StaticResource Border1}"/>
                </StackPanel>

                <!-- Memory Panel -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                    <TextBlock Text="👤  SESSION INFO"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource InputBg}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="User Name" FontSize="10" Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="TxtMemoryName"
                                       Text="Not set"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource InputBg}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Favourite Topic" FontSize="10" Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="TxtMemoryTopic"
                                       Text="Not set"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,10,0,10" Background="{StaticResource Border1}"/>
                </StackPanel>

                <!-- Quick Topics -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                    <TextBlock Text="🚀  QUICK TOPICS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ChipButton}" Content="🔑 Password"  Click="ChipButton_Click" Tag="password"/>
                        <Button Style="{StaticResource ChipButton}" Content="🎣 Phishing"  Click="ChipButton_Click" Tag="phishing"/>
                        <Button Style="{StaticResource ChipButton}" Content="🛡️ Privacy"   Click="ChipButton_Click" Tag="privacy"/>
                        <Button Style="{StaticResource ChipButton}" Content="💰 Scams"     Click="ChipButton_Click" Tag="scam"/>
                        <Button Style="{StaticResource ChipButton}" Content="🦠 Malware"   Click="ChipButton_Click" Tag="malware"/>
                        <Button Style="{StaticResource ChipButton}" Content="🔒 2FA"       Click="ChipButton_Click" Tag="2fa"/>
                        <Button Style="{StaticResource ChipButton}" Content="🌐 Browsing"  Click="ChipButton_Click" Tag="safe browsing"/>
                        <Button Style="{StaticResource ChipButton}" Content="🎭 Soc. Eng." Click="ChipButton_Click" Tag="social engineering"/>
                    </WrapPanel>
                    <Separator Margin="0,10,0,10" Background="{StaticResource Border1}"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Border Background="{StaticResource InputBg}" CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bot is online and ready"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Border1}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Cybersecurity Awareness Bot"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource LightText}"/>
                            <TextBlock x:Name="TxtGreeting"
                                       Text="Ask me anything about staying safe online"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="🗑️ Clear Chat"
                            Click="BtnClear_Click"
                            Style="{StaticResource ChipButton}"
                            HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,10">
                <StackPanel x:Name="ChatPanel" Margin="0,10"/>
            </ScrollViewer>

            <!-- Input bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Border1}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource Border1}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,10,0">
                        <TextBox x:Name="TxtInput"
                                 Background="Transparent"
                                 Foreground="{StaticResource LightText}"
                                 CaretBrush="{StaticResource AccentGreen}"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Padding="14,10"
                                 VerticalAlignment="Center"
                                 KeyDown="TxtInput_KeyDown"
                                 GotFocus="TxtInput_GotFocus"
                                 LostFocus="TxtInput_LostFocus"
                                 Tag="Type a message or ask about cybersecurity topics..."/>
                    </Border>
                    <Button Grid.Column="1"
                            x:Name="BtnSend"
                            Content="Send  ➤"
                            Style="{StaticResource SendButton}"
                            Click="BtnSend_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>